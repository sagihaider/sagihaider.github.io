{% case project.theme %}
  {% when "healthcare" %}{% assign theme_label = "Healthcare" %}
  {% when "environment" %}{% assign theme_label = "Environment" %}
  {% when "enterprise" %}{% assign theme_label = "Enterprise" %}
  {% when "public-policy" %}{% assign theme_label = "Public policy" %}
{% endcase %}
<article class="project-card" data-status="{{ project.status }}" data-theme="{{ project.theme }}">
  <div class="project-card__top">
    <a class="project-card__visual" href="{{ project.url | relative_url }}" aria-label="View project: {{ project.title }}">
      {% if project.img %}
        <img src="{{ project.img | relative_url }}" width="76" height="76" loading="lazy" alt="{{ project.title }} project visual">
      {% else %}
        {% case project.theme %}
          {% when "healthcare" %}
            <svg viewBox="0 0 48 48" role="img" aria-label="Healthcare project"><path d="M24 39S8 30 8 17.5C8 12 12 9 16.5 9c3.2 0 5.8 1.7 7.5 4.3C25.7 10.7 28.3 9 31.5 9 36 9 40 12 40 17.5 40 30 24 39 24 39Z"/><path d="M15 24h6l2-5 3 10 2-5h5"/></svg>
          {% when "environment" %}
            <svg viewBox="0 0 48 48" role="img" aria-label="Environment project"><path d="M39 9C22 10 12 18 12 30c0 5 3 9 8 9 12 0 19-13 19-30Z"/><path d="M9 40c6-11 13-17 24-24M20 29c3 0 6 .5 9 2M25 23c0-3 .5-5 1-7"/></svg>
          {% when "public-policy" %}
            <svg viewBox="0 0 48 48" role="img" aria-label="Public policy project"><path d="M7 18h34L24 8 7 18Zm4 4v15m9-15v15m8-15v15m9-15v15M7 41h34"/></svg>
          {% else %}
            <svg viewBox="0 0 48 48" role="img" aria-label="Enterprise project"><circle cx="13" cy="15" r="5"/><circle cx="35" cy="12" r="5"/><circle cx="34" cy="35" r="5"/><circle cx="13" cy="35" r="5"/><path d="m18 15 12-2m4 4v13m-5 5H18m-5-5V20m4-1 13 12"/></svg>
        {% endcase %}
      {% endif %}
    </a>
    <div class="project-card__meta">
      <span class="project-status project-status--{{ project.status }}">{{ project.status | capitalize }}</span>
      <span>{{ theme_label }}</span>
      <span>{{ project.period }}</span>
    </div>
  </div>
  <h3><a href="{{ project.url | relative_url }}">{{ project.title }}</a></h3>
  <p>{{ project.description }}</p>
  <a class="project-card__link" href="{{ project.url | relative_url }}" aria-label="View project: {{ project.title }}">View project <span aria-hidden="true">→</span></a>
</article>
